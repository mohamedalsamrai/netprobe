# One iperf3 listener per agent port. Install on the iperf3 server:
#   sudo cp iperf3@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now iperf3@5201 iperf3@5202 iperf3@5203 iperf3@5204 iperf3@5205
[Unit]
Description=iperf3 server on port %i
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/iperf3 -s -p %i
Restart=always
RestartSec=2
DynamicUser=yes

[Install]
WantedBy=multi-user.target
